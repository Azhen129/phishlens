{
  "name": "phishlens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-frontend-tests.mjs",
    "test:e2e": "playwright test",
    "format:check": "prettier --check frontend/src vite.config.ts playwright.config.ts tests/e2e scripts/visual-compare.mjs scripts/run-frontend-tests.mjs",
    "verify:visual": "node scripts/visual-compare.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^6.3.6",
    "vitest": "^4.1.12"
  }
}
